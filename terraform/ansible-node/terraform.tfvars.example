# ============================================================================
# terraform.tfvars のテンプレート
#   cp terraform.tfvars.example terraform.tfvars して値を設定する
#   ※ terraform.tfvars は .gitignore 対象（リポジトリにコミットしないこと）
# ============================================================================

# ★HCP Terraform で実行する場合、このファイルは使いません★
#   .gitignore で *.tfvars は除外されるためリポジトリにも入りません。
#   変数は HCP ワークスペースの「Variables」に設定してください（README 参照）。
#   本ファイルはローカル実行時のみ使用します。

# ---- 必須 -------------------------------------------------------------------
# SSH(22) を許可する送信元。運用端末のグローバル IP を指定する。
# 確認方法: curl -s https://ifconfig.me
allowed_ssh_source_addresses = ["203.0.113.10/32"]

# ---- 全体 -------------------------------------------------------------------
# subscription_id = "00000000-0000-0000-0000-000000000000"   # 未指定なら ARM_SUBSCRIPTION_ID を使用
prefix   = "pickles"
env      = "verify"
location = "japaneast"

# リソースグループ名（既定: rg-<prefix>-<env>-ansible）
# resource_group_name = "rg-pickles-verify-ansible"

# Owner タグは既定で "TF-J32474"（Terraform 管理 + 管理番号）が全リソースに付与される。
# 変更する場合のみ指定する。
# owner_tag = "TF-J32474"

# 追加タグ（Owner は owner_tag が優先されるため、ここで指定しても上書きされない）
tags = {
  CostTag = "verification"
}

# ---- ネットワーク -----------------------------------------------------------
# 既定では専用の VNet を新規作成する。Windows サーバ側（10.0.0.0/16 想定）と
# 重複しないアドレス空間にすること。
vnet_address_space      = ["10.90.0.0/16"]
subnet_address_prefixes = ["10.90.1.0/24"]

# 既存サブネットへ配置する場合はこちらを指定する（VNet は作成されない）
# existing_subnet_id = "/subscriptions/.../resourceGroups/.../providers/Microsoft.Network/virtualNetworks/vnet-xxx/subnets/snet-xxx"

create_public_ip = true

# 別環境に既存の Windows サーバがある場合の Public IP。
# ここへの WinRM(5986) 送信を明示的に許可する（受信側は terraform/windows-nsg で構成）。
# ※本ワークスペースで Windows を作成する場合（create_windows_server = true）は
#   その Public IP が自動で追加されるため、通常は指定不要。
# windows_server_public_ips = ["203.0.113.20/32", "203.0.113.21/32"]

# ---- 仮想マシン -------------------------------------------------------------
vm_size        = "Standard_B2s"
admin_username = "azureuser"
os_disk_size_gb = 64

# SSH 公開鍵。ローカル実行ならパス指定でよい。
ssh_public_key_path = "~/.ssh/id_rsa.pub"
# HCP Terraform で実行する場合はファイルを参照できないため、
# 公開鍵の「内容」をワークスペースの Terraform variables に設定すること。
# （このファイルではなく HCP の UI 側で設定する）
# ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@host"

# ---- セットアップ内容 -------------------------------------------------------
# Playbook リポジトリを clone する場合に指定する（未指定なら rsync 等で転送）
# ※プライベートリポジトリの場合、cloud-init には認証情報が無いため clone に失敗する。
#   その場合は空のままにして、SSH 接続後に手動で clone するか rsync で転送すること。
# git_repository_url = "https://github.com/ishida-hiro/ansible-test-J32474.git"

# ---- コスト対策 -------------------------------------------------------------
enable_auto_shutdown   = true
auto_shutdown_time     = "2100"
auto_shutdown_timezone = "Tokyo Standard Time"

# ---- 構築対象 Windows サーバ（同一ワークスペースで作成する） ----------------
# Ansible 実行サーバとは別 VNet に配置し、Public IP 経由で接続する。
create_windows_server = true

windows_vm_size       = "Standard_B2s"     # 検証用途の小さめサイズ（2vCPU/4GB）
windows_computer_name = "Ansible-TEST-FS"  # inventory/test.yml のホスト名と揃える

# Ansible の接続ユーザ。inventory/group_vars/all/vault.yml の
# vault_local_admin_user / vault_local_admin_password と一致させること。
windows_admin_username = "picklesadmin"
# 未指定なら自動生成される（terraform output windows_admin_password_generated で取得）
# windows_admin_password = "<12文字以上・英大小/数字/記号のうち3種類以上>"

# OS イメージ（既定: Windows Server 2025 Datacenter Azure Edition）
# windows_source_image = {
#   publisher = "MicrosoftWindowsServer"
#   offer     = "WindowsServer"
#   sku       = "2025-datacenter-azure-edition"
#   version   = "latest"
# }

# ディスク（D: 相当のデータディスク。0 で作成しない）
windows_os_disk_size_gb   = 128
windows_data_disk_size_gb = 32

# Windows 側ネットワーク（Ansible 側 10.90.0.0/16 と重複しないこと。ピアリングしない）
windows_vnet_address_space      = ["10.91.0.0/16"]
windows_subnet_address_prefixes = ["10.91.1.0/24"]

# Public IP の DNS ラベル。空なら <prefix>-<env>-win-<ランダム5文字> を自動生成する。
# ※Azure は商標語（windows / microsoft / azure / xbox 等）を含むラベルを拒否するため、
#   リソース名と違い "win" に短縮している。
# windows_domain_name_label = "pickles-verify-fs01"

# RDP(3389) の許可元。空なら allowed_ssh_source_addresses と同じ値を使う。
# allowed_rdp_source_addresses = ["203.0.113.10/32"]
enable_rdp_rule = true

# bootstrap_winrm.ps1 を Run Command で自動実行し WinRM(5986) を有効化する
enable_winrm_bootstrap = true
