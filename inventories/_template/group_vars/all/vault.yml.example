---
# ============================================================================
# 認証情報テンプレート
#   1) 本ファイルを vault.yml にコピーして値を設定
#   2) ansible-vault encrypt inventories/<案件>/group_vars/all/vault.yml
#   ※ 平文のままリポジトリへコミットしないこと（vault.yml は .gitignore 対象）
# ============================================================================
# 構築中の接続ユーザ（group_vars/windows.yml が参照する）
vault_local_admin_user:      "<ローカル管理者名>"
vault_local_admin_password:  "<ローカル管理者パスワード>"

# ドメイン参加 / DC 昇格用（enable_domain_join: true の場合）
vault_domain_admin_user:     "<NETBIOS名>\\Administrator"
vault_domain_admin_password: "<ドメイン管理者パスワード>"
vault_safe_mode_password:    "<DSRM(ディレクトリサービス復元モード)パスワード>"

# ローカルユーザ（設計書 1.3）。local_users[].password から参照する変数を追加する
# vault_<ユーザ名>_password: "<パスワード>"

# タスクスケジューラ実行ユーザ（設計書 1.13）
# ※Azure の Windows VM には Administrator が存在しない（docs/03_要確認事項.md B-4）
vault_task_run_user:         "<タスク実行ユーザ>"
vault_task_run_password:     "<タスク実行ユーザのパスワード>"
