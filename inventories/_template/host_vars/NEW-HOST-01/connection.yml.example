# ============================================================================
# NEW-HOST-01 : 接続先（環境固有・git 管理外）
#   このファイルを connection.yml として複製し、実機の IP に書き換えて使う。
#
#     cp inventories/<案件>/host_vars/NEW-HOST-01/connection.yml.example \
#        inventories/<案件>/host_vars/NEW-HOST-01/connection.yml
#
#   接続先 IP は VM を作り直すたびに変わるため、インベントリ本体（hosts.yml）
#   ではなくここに置いて git 管理から外している。
# ============================================================================
ansible_host: 203.0.113.20
